<% return unless site_setting.matomo_enabled? %>

<div id="matomo-config"
     data-tracker-url="<%= site_setting.matomo_tracker_base_url %>/"
     data-site-id="<%= site_setting.matomo_site_id %>"
     hidden></div>
<script>
  var _paq = window._paq = window._paq || [];
  _paq.push(['enableLinkTracking']);
  (function () {
    var cfg = document.getElementById('matomo-config');
    var u = cfg.dataset.trackerUrl;
    var siteId = Number(cfg.dataset.siteId);
    _paq.push(['setTrackerUrl', u + 'matomo.php']);
    _paq.push(['setSiteId', siteId]);
    var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
    g.async = true;
    g.src = u + 'matomo.js';
    s.parentNode.insertBefore(g, s);
  })();

  document.addEventListener('turbo:load', function () {
    _paq.push(['setCustomUrl', window.location.href]);
    _paq.push(['setDocumentTitle', document.title]);
    _paq.push(['trackPageView']);
  });
</script>
