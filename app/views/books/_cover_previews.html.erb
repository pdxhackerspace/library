<% cover_urls = Array(local_assigns[:cover_urls]).compact_blank %>
<% existing_covers = book&.covers_attached? ? book.covers.to_a : [] %>
<% existing_urls = existing_covers.map { |cover| url_for(cover) } %>
<% pending_urls = cover_urls - existing_urls %>

<% if existing_covers.any? || pending_urls.any? %>
  <div class="text-secondary small mb-2">Covers</div>
  <div class="d-flex flex-wrap gap-2 mb-2">
    <% existing_covers.zip(existing_urls).each do |cover, url| %>
      <div class="text-center">
        <img src="<%= url %>" alt="" class="rounded border border-secondary-subtle d-block" style="height: 96px; width: auto;">
        <div class="form-check form-check-inline small mt-1 me-0">
          <input type="checkbox"
                 class="form-check-input"
                 name="book[remove_cover_ids][]"
                 value="<%= cover.id %>"
                 id="remove_cover_<%= cover.id %>">
          <label class="form-check-label" for="remove_cover_<%= cover.id %>">Remove</label>
        </div>
      </div>
    <% end %>
    <% pending_urls.each do |url| %>
      <img src="<%= url %>" alt="" class="rounded border border-secondary-subtle" style="height: 96px; width: auto;">
    <% end %>
  </div>
<% end %>

<% cover_urls.each do |url| %>
  <input type="hidden" name="book[pending_cover_urls][]" value="<%= url %>">
<% end %>
