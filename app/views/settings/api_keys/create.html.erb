<% content_for :title, "API key created · #{site_name}" %>

<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Settings</h1>
    <div class="text-13 text-secondary mt-1">Site configuration</div>
  </div>
</div>

<div class="row">
  <div class="col-md-3">
    <%= render 'settings/nav', active: :api_keys %>
  </div>
  <div class="col-md-9">
    <section class="mb-4">
      <h2 class="h-section-label">API key created</h2>
      <div class="alert alert-warning py-2 small">
        Copy this key now. It won't be shown again; only a fingerprint is stored.
      </div>
      <div class="card border-secondary-subtle mb-3">
        <div class="card-body">
          <div class="text-13 text-secondary mb-1"><%= @api_key.name %></div>
          <input type="text" class="form-control form-control-sm font-monospace" readonly value="<%= @api_key.token %>"
                 aria-label="API key">
        </div>
      </div>

      <p class="text-13 text-secondary mb-2">Fetch the catalog feed with:</p>
      <pre class="small bg-body-tertiary p-2 rounded"><code>curl -H "Authorization: Bearer <%= @api_key.token %>" <%= api_v1_catalog_url %></code></pre>

      <%= link_to 'Back to settings', settings_path(anchor: 'api-keys'), class: 'btn btn-outline-secondary btn-sm' %>
    </section>
  </div>
</div>
